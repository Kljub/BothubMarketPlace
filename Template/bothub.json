{
  "schemaVersion": 1,
  "id": "plugin_template",
  "name": "Template",
  "version": "1.0.0",
  "description": "Plugin template with every layer: commands, events, services (storage, messages, tasks, API, voice), nodes and a dashboard page.",
  "developer": {
    "name": "BotHub"
  },
  "license": "MIT",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "discord.messages.send",
      "discord.events.members",
      "scheduler",
      "secrets.use",
      "discord.voice.connect",
      "discord.voice.speak"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/hello.json"
  ],
  "events": [
    "guildMemberAdd"
  ],
  "services": {
    "tasks": [
      {
        "name": "daily_report",
        "cron": "0 9 * * *"
      },
      {
        "name": "cleanup",
        "every": "6h"
      }
    ],
    "secrets": [
      "EXAMPLE_URL",
      "EXAMPLE_KEY"
    ]
  },
  "nodes": [
    "hello",
    "reply_for",
    "count",
    "announce",
    "api_get",
    "play_sound",
    "stop_sound"
  ],
  "dashboard": {
    "settings": "dashboard/settings.json"
  },
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  }
}
