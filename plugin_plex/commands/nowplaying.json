{
  "name": "plex-nowplaying",
  "description": "Shows what is playing on Plex",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "plex-nowplaying",
          "description": "Shows what is playing on Plex",
          "hide_replies": false,
          "visibility_option": "visibility"
        },
        "position": {
          "x": 400,
          "y": 40
        }
      },
      {
        "id": "option_visibility",
        "type": "option.choice",
        "typeVersion": 1,
        "config": {
          "name": "visibility",
          "description": "Who sees the answer (empty: the default of the bot)",
          "required": false,
          "choices": "Public\nOnly me",
          "variable": "visibility"
        },
        "position": {
          "x": 400,
          "y": 40
        }
      },
      {
        "id": "np",
        "type": "plugin.plugin_plex.now_playing",
        "typeVersion": 1,
        "config": {
          "variable": "px"
        },
        "position": {
          "x": 400,
          "y": 190
        }
      },
      {
        "id": "ok",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "embeds": [
              {
                "color": "#e5a00d",
                "title": "📺 Now playing ({px.count})",
                "description": "{px}"
              }
            ]
          },
          "target": "reply"
        },
        "position": {
          "x": -120,
          "y": 340
        }
      },
      {
        "id": "empty",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "📺 Nothing is playing right now."
          },
          "target": "reply"
        },
        "position": {
          "x": 400,
          "y": 340
        }
      },
      {
        "id": "failed",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {px}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 920,
          "y": 340
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 1560,
          "y": 40
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 1560,
          "y": 190
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_visibility",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "np",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "np",
          "port": "next"
        },
        "to": {
          "node": "ok",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "np",
          "port": "empty"
        },
        "to": {
          "node": "empty",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "np",
          "port": "failed"
        },
        "to": {
          "node": "failed",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
