{
  "name": "plex-recommend",
  "description": "A recommendation from your watch history",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "plex-recommend",
          "description": "A recommendation from your watch history"
        },
        "position": {
          "x": 120,
          "y": 240
        }
      },
      {
        "id": "rec",
        "type": "plugin.plugin_plex.recommend",
        "typeVersion": 1,
        "config": {
          "variable": "px"
        },
        "position": {
          "x": 440,
          "y": 240
        }
      },
      {
        "id": "ok",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "embeds": [
              {
                "color": "#e5a00d",
                "title": "🎬 {px}",
                "description": "{px.summary}",
                "fields": [
                  {
                    "name": "Year",
                    "value": "{px.year}",
                    "inline": true
                  },
                  {
                    "name": "Rating",
                    "value": "{px.rating}",
                    "inline": true
                  },
                  {
                    "name": "Duration",
                    "value": "{px.duration}",
                    "inline": true
                  },
                  {
                    "name": "Genres",
                    "value": "{px.genres}",
                    "inline": false
                  }
                ],
                "footer": {
                  "text": "Plex · {px.library}"
                }
              }
            ]
          },
          "target": "reply"
        },
        "position": {
          "x": 760,
          "y": 240
        }
      },
      {
        "id": "nolink",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ Link your Plex account first: /plex-link"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 760,
          "y": 370
        }
      },
      {
        "id": "empty",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "🎬 No recommendation found."
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 1080,
          "y": 370
        }
      },
      {
        "id": "failed",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {px}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 760,
          "y": 500
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 120,
          "y": 900
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 440,
          "y": 900
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "rec",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "rec",
          "port": "next"
        },
        "to": {
          "node": "ok",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "rec",
          "port": "not_linked"
        },
        "to": {
          "node": "nolink",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "rec",
          "port": "empty"
        },
        "to": {
          "node": "empty",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "rec",
          "port": "failed"
        },
        "to": {
          "node": "failed",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
