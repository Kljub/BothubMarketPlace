{
  "schemaVersion": 1,
  "id": "plugin_plex",
  "name": "Plex",
  "version": "1.2.0",
  "description": "Plex for Discord: library search, now playing, random picks, recommendations, Overseerr requests, account linking with a role, and new-content notices.",
  "developer": {
    "name": "BotHub"
  },
  "license": "MIT",
  "icon": "🎬",
  "category": "social",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "storage.global",
      "discord.messages.send",
      "scheduler",
      "http.endpoints",
      "http.outbound",
      "discord.interactions.reply",
      "discord.roles.assign",
      "webhooks.inbound"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/link.json",
    "commands/unlink.json",
    "commands/status.json",
    "commands/nowplaying.json",
    "commands/search.json",
    "commands/random.json",
    "commands/recommend.json",
    "commands/request.json",
    "commands/libraries.json",
    "commands/plex-watchlist.json",
    "commands/plex-watchlist-add.json",
    "commands/plex-watchlist-remove.json"
  ],
  "services": {
    "tasks": [
      {
        "name": "link_poll",
        "every": "1m"
      }
    ],
    "endpoints": [
      "PLEX_API",
      "PLEX_API_2",
      "PLEX_API_3",
      "PLEX_API_4",
      "PLEX_API_5",
      "OVERSEERR_API"
    ],
    "connect": {
      "PLEX_API": "plex",
      "PLEX_API_2": "plex",
      "PLEX_API_3": "plex",
      "PLEX_API_4": "plex",
      "PLEX_API_5": "plex"
    },
    "hosts": [
      "plex.tv",
      "discover.provider.plex.tv"
    ],
    "webhooks": [
      "media",
      "overseerr"
    ]
  },
  "nodes": [
    "status",
    "now_playing",
    "search",
    "random",
    "recommend",
    "request",
    "link",
    "unlink_account",
    "libraries",
    "watchlist",
    "watchlist_add",
    "watchlist_remove"
  ],
  "dashboard": {
    "settings": "dashboard/settings.json"
  },
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  }
}
