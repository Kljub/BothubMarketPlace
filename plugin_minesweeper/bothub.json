{
  "schemaVersion": 1,
  "id": "plugin_minesweeper",
  "name": "Minesweeper",
  "version": "1.0.0",
  "description": "A 24-field mine bet: the member picks the number of mines, every diamond raises the multiplier, 🔥 cashes out. RTP per bot.",
  "developer": {
    "name": "BotHub"
  },
  "license": "MIT",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "scheduler",
      "discord.interactions.reply",
      "modules.economy.balance.read",
      "modules.economy.balance.write"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/minesweeper.json"
  ],
  "nodes": [
    "play"
  ],
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  },
  "icon": "💣",
  "category": "fun",
  "services": {
    "tasks": [
      {
        "name": "expire",
        "every": "1m"
      }
    ]
  },
  "dashboard": {
    "settings": "dashboard/settings.json"
  }
}
