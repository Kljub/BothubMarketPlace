{
  "name": "minesweeper",
  "description": "Minesweeper bet: find diamonds, avoid mines, cash out",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "minesweeper",
          "description": "Minesweeper bet: find diamonds, avoid mines, cash out"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_bet",
        "type": "option.number",
        "typeVersion": 1,
        "config": {
          "name": "bet",
          "description": "Your bet",
          "required": true,
          "variable": "bet"
        },
        "position": {
          "x": 140,
          "y": 40
        }
      },
      {
        "id": "option_mines",
        "type": "option.number",
        "typeVersion": 1,
        "config": {
          "name": "mines",
          "description": "Mines (1-23, more = higher multiplier)",
          "required": false,
          "variable": "mines"
        },
        "position": {
          "x": 400,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_minesweeper.play",
        "typeVersion": 1,
        "config": {
          "bet": "{option_bet}",
          "mines": "{option_mines}",
          "variable": "res"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_bet",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "option_mines",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
