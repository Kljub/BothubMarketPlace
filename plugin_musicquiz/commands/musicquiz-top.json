{
  "name": "musicquiz-top",
  "description": "The music quiz leaderboard of this server",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "musicquiz-top",
          "description": "The music quiz leaderboard of this server"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "opt_by",
        "type": "option.choice",
        "typeVersion": 1,
        "config": {
          "name": "by",
          "description": "Ranked by (default: points)",
          "required": false,
          "variable": "by",
          "choices": "points\ncorrect\nwins"
        },
        "position": {
          "x": 120,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_musicquiz.top",
        "typeVersion": 1,
        "config": {
          "by": "{option_by}",
          "variable": "res"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "opt_by",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
