{
  "name": "cooldown",
  "description": "Reminds you when a cooldown is over",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "cooldown",
          "description": "Reminds you when a cooldown is over"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_name",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "name",
          "description": "Cooldown name (see /cooldowns)",
          "required": true,
          "variable": "name"
        },
        "position": {
          "x": 140,
          "y": 40
        }
      },
      {
        "id": "option_minutes",
        "type": "option.number",
        "typeVersion": 1,
        "config": {
          "name": "minutes",
          "description": "Own minutes (when allowed)",
          "required": false,
          "variable": "minutes"
        },
        "position": {
          "x": 360,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_cooldowns.start",
        "typeVersion": 1,
        "config": {
          "name": "{option_name}",
          "minutes": "{option_minutes}",
          "variable": "res"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_name",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "option_minutes",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
