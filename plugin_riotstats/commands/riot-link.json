{
  "name": "riot-link",
  "description": "Link your Riot ID on this server (all Riot games)",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "riot-link",
          "description": "Link your Riot ID on this server (all Riot games)"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "opt_player",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "player",
