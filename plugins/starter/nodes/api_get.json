{
  "category": "action",
  "labelKey": "plugin.starter.node.api_get.label",
  "descriptionKey": "plugin.starter.node.api_get.description",
  "inputs": [{ "name": "in", "type": "flow", "multiple": true }],
  "outputs": [
    { "name": "next", "type": "flow" },
    { "name": "failed", "type": "flow" }
  ],
  "results": [
    { "suffix": "", "labelKey": "plugin.starter.node.api_get.result" },
    { "suffix": ".status", "labelKey": "plugin.starter.node.api_get.result_status" }
  ],
  "config": {
    "type": "object",
    "additionalProperties": false,
    "required": ["path"],
    "properties": {
      "path": { "type": "string", "maxLength": 500, "default": "/" },
      "query": { "type": "string", "maxLength": 500 },
      "field": { "type": "string", "maxLength": 200 },
      "variable": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$" }
    }
  }
}
