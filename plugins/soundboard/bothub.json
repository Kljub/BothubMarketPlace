{
  "$schema": "../../schema/plugin-manifest.schema.json",
  "schemaVersion": 1,
  "id": "soundboard",
  "name": "Soundboard",
  "version": "1.0.0",
  "description": "Plays short sounds in a voice channel.",
  "developer": {
    "name": "BotHub"
  },
  "license": "MIT",
  "sdk": {
    "version": 1,
    "permissions": [
      "discord.voice"
    ]
  },
  "main": "index.js",
  "nodes": [
    "play_sound",
    "stop_sound"
  ],
  "dashboard": {
    "settings": "dashboard/settings.json"
  },
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  }
}
