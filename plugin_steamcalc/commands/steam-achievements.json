{
  "name": "steam-achievements",
  "description": "Shows the Steam achievements of a player in a game",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "steam-achievements",
          "description": "Shows the Steam achievements of a player in a game"
        },
        "position": {
          "x": 400,
          "y": 40
        }
      },
      {
        "id": "opt_player",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "player",
          "description": "Steam custom URL name, profile link or SteamID64",
          "required": true,
          "variable": "player"
        },
        "position": {
          "x": 120,
          "y": 40
        }
      },
      {
        "id": "opt_game",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "game",
          "description": "Game: name, store link or app ID",
          "required": true,
          "variable": "game"
        },
        "position": {
          "x": 120,
          "y": 190
        }
      },
      {
        "id": "achievements",
        "type": "plugin.plugin_steamcalc.achievements",
        "typeVersion": 1,
        "config": {
          "player": "{option_player}",
          "game": "{option_game}",
          "variable": "steam"
        },
        "position": {
          "x": 400,
          "y": 190
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "opt_player",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "opt_game",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "achievements",
          "port": "in"
        }
      }
    ]
  }
}
