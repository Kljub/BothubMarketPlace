{
  "schemaVersion": 1,
  "id": "plugin_steamcalc",
  "name": "Steam Calc & Stats",
  "version": "1.1.0",
  "description": "What a Steam account is worth (/steam-calc), Steam profiles (/steam-profile) and achievements (/steam-achievements, tracker posting new unlocks).",
  "developer": {
    "name": "BotHub"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "icon": "🧮",
  "category": "fun",
  "sdk": {
    "version": 1,
    "permissions": [
      "secrets.use",
      "discord.interactions.reply",
      "storage",
      "scheduler",
      "discord.messages.send"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/steam-calc.json",
    "commands/steam-profile.json",
    "commands/steam-achievements.json"
  ],
  "services": {
    "secrets": [
      "STEAM_API_KEY"
    ],
    "hosts": [
      "api.steampowered.com",
      "store.steampowered.com"
    ],
    "tasks": [
      {
        "name": "tick",
        "every": "30m"
      }
    ]
  },
  "nodes": [
    "calc",
    "profile",
    "achievements"
  ],
  "dashboard": {
    "settings": "dashboard/settings.json"
  },
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  }
}
