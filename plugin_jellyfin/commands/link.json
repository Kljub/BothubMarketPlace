{
  "name": "jellyfin-link",
  "description": "Links your Jellyfin account",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "jellyfin-link",
          "description": "Links your Jellyfin account",
          "hide_replies": true
        },
        "position": {
          "x": 400,
          "y": 40
        }
      },
      {
        "id": "link",
        "type": "plugin.plugin_jellyfin.link",
        "typeVersion": 1,
        "config": {
          "variable": "jf",
          "server": "{option_server}"
        },
        "position": {
          "x": 400,
          "y": 190
        }
      },
      {
        "id": "ok",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "🔗 Open Jellyfin (**{jf}**) → your profile → **Quick Connect** and enter the code **{jf.code}** (within 10 minutes).\nThe bot confirms by DM when it is done."
          },
          "target": "reply"
        },
        "position": {
          "x": 140,
          "y": 340
        }
      },
      {
        "id": "already",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "ℹ️ You are linked as **{jf}** already. /jellyfin-unlink removes it."
          },
          "target": "reply"
        },
        "position": {
          "x": 660,
          "y": 340
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 1300,
          "y": 40
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 1300,
          "y": 190
        }
      },
      {
        "id": "option_server",
        "type": "option.number",
        "typeVersion": 1,
        "config": {
          "name": "server",
          "description": "Which Jellyfin server (1-5, empty: the first)",
          "required": false,
          "variable": "server"
        },
        "position": {
          "x": 700,
          "y": 40
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "link",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "link",
          "port": "next"
        },
        "to": {
          "node": "ok",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "link",
          "port": "already"
        },
        "to": {
          "node": "already",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "option_server",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      }
    ]
  }
}
