        },
        "to": {
          "node": "empty",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "wl",
          "port": "not_linked"
        },
        "to": {
          "node": "not_linked",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "wl",
          "port": "failed"
        },
        "to": {
          "node": "failed",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
