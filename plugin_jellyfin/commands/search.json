{
  "name": "jellyfin-search",
  "description": "Searches the Jellyfin libraries",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "jellyfin-search",
          "description": "Searches the Jellyfin libraries",
          "hide_replies": false,
          "visibility_option": "visibility"
        },
        "position": {
          "x": 400,
          "y": 190
        }
      },
      {
        "id": "option_visibility",
        "type": "option.choice",
        "typeVersion": 1,
        "config": {
          "name": "visibility",
          "description": "Who sees the answer (empty: the default of the bot)",
          "required": false,
          "choices": "Public\nOnly me",
          "variable": "visibility"
        },
        "position": {
          "x": 660,
          "y": 40
        }
      },
      {
        "id": "option_title",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "title",
          "description": "Title of the movie or show",
          "required": true,
          "variable": "title"
        },
        "position": {
          "x": 400,
          "y": 40
        }
      },
      {
        "id": "search",
        "type": "plugin.plugin_jellyfin.search",
        "typeVersion": 1,
        "config": {
          "title": "{option_title}",
          "variable": "jf"
        },
        "position": {
          "x": 400,
          "y": 340
        }
      },
      {
        "id": "found",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "embeds": [
              {
                "color": "#aa5cc3",
                "title": "🔍 {jf}",
                "description": "{jf.summary}",
                "fields": [
                  {
                    "name": "Year",
                    "value": "{jf.year}",
                    "inline": true
                  },
                  {
                    "name": "Rating",
                    "value": "{jf.rating}",
                    "inline": true
                  },
                  {
                    "name": "Duration",
                    "value": "{jf.duration}",
                    "inline": true
                  },
                  {
                    "name": "Genres",
                    "value": "{jf.genres}",
                    "inline": false
                  }
                ],
                "footer": {
                  "text": "Jellyfin · {jf.library}"
                }
              }
            ]
          },
          "target": "reply"
        },
        "position": {
          "x": -120,
          "y": 490
        }
      },
      {
        "id": "none",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "🔍 Nothing found for \"{option_title}\"."
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 400,
          "y": 490
        }
      },
      {
        "id": "failed",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {jf}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 920,
          "y": 490
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 1560,
          "y": 190
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 1560,
          "y": 340
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_visibility",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "option_title",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "search",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "search",
          "port": "found"
        },
        "to": {
          "node": "found",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "search",
          "port": "not_found"
        },
        "to": {
          "node": "none",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "search",
          "port": "failed"
        },
        "to": {
          "node": "failed",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
