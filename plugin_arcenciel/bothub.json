{
  "schemaVersion": 1,
  "id": "plugin_arcenciel",
  "name": "ArcEnCiel",
  "version": "1.2.0",
  "description": "AI images from arcenciel.io in Discord: /imagine, /img2img, /autotag and /arc-models.",
  "developer": {
    "name": "BotHub"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "icon": "🎨",
  "category": "fun",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "storage.files",
      "secrets.use",
      "discord.interactions.reply",
      "discord.messages.files",
      "discord.channels.read"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/imagine.json",
    "commands/img2img.json",
    "commands/autotag.json",
    "commands/models.json"
  ],
  "services": {
    "secrets": [
      "ARCENCIEL_API_KEY"
    ],
    "hosts": [
      "arcenciel.io"
    ]
  },
  "nodes": [
    "imagine",
    "img2img",
    "autotag",
    "models"
  ],
  "dashboard": {
    "settings": "dashboard/settings.json"
  },
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  }
}
