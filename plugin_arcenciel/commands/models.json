{
  "name": "arc-models",
  "description": "Shows the Arc en Ciel models and lets you pick yours",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "arc-models",
          "description": "Shows the Arc en Ciel models and lets you pick yours"
        },
        "position": {
          "x": 520,
          "y": 40
        }
      },
      {
        "id": "opt_image",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "search",
          "description": "Search term, e.g. anime (empty: all models)",
          "required": false,
          "variable": "search"
        },
        "position": {
          "x": 120,
          "y": 40
        }
      },
      {
        "id": "block",
        "type": "plugin.plugin_arcenciel.models",
        "typeVersion": 1,
        "config": {
          "search": "{option_search}",
          "variable": "models"
        },
        "position": {
          "x": 520,
          "y": 200
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 900,
          "y": 40
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 900,
          "y": 200
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "opt_image",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "block",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
