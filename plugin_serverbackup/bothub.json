{
  "schemaVersion": 1,
  "id": "plugin_serverbackup",
  "name": "Server Backup",
  "version": "1.0.0",
  "description": "Backups of a whole server (roles and permissions, channels with their permissions, emojis, settings, optionally bans) by command or schedule; restore them or clone them into another server.",
  "developer": {
    "name": "BotHub"
  },
  "license": "MIT",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "storage.files",
      "scheduler",
      "discord.server.backup",
      "discord.server.restore",
      "discord.guilds.read",
      "discord.interactions.reply",
      "discord.messages.send"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/backup-create.json",
    "commands/backup-info.json",
    "commands/backup-delete.json",
    "commands/backup-restore.json",
    "commands/backup-clone.json"
  ],
  "nodes": [
    "create",
    "info",
    "delete",
    "restore",
    "clone"
  ],
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  },
  "icon": "💾",
  "category": "utility",
  "services": {
    "tasks": [
      {
        "name": "schedule",
        "every": "1m"
      }
    ]
  },
  "dashboard": {
    "settings": "dashboard/settings.json"
  }
}
