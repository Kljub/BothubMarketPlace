    {
      "key": "schedule_day",
      "type": "select",
      "options": [
        "daily",
        "d1",
        "d2",
        "d3",
        "d4",
        "d5",
        "d6",
        "d0"
      ],
      "default": "daily",
      "showIf": {
        "schedule": [
          "true"
        ]
      }
    },
    {
      "key": "schedule_time",
      "type": "text",
      "max": 5,
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "default": "03:00",
      "showIf": {
        "schedule": [
          "true"
        ]
      }
    },
    {
      "key": "timezone",
      "type": "text",
      "max": 64,
      "default": "Europe/Berlin",
      "hint": true,
      "showIf": {
        "schedule": [
          "true"
        ]
      }
    }
  ]
