{
  "name": "backup clone",
  "description": "Copies the backup of another server into this one",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "backup clone",
          "description": "Copies the backup of another server into this one",
          "permissions": {
            "allowed_roles": [
              {
                "id": "everyone"
              }
            ],
            "banned_roles": [],
            "required_permissions": [
              "manage_guild"
            ],
            "banned_channels": [],
            "hide_without_permission": true
          }
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_source",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "source",
          "description": "ID of the server to copy",
          "required": true,
          "variable": "source"
        },
        "position": {
          "x": 140,
          "y": 40
        }
      },
      {
        "id": "option_number",
        "type": "option.number",
        "typeVersion": 1,
        "config": {
          "name": "number",
          "description": "Which backup (1 = newest)",
          "required": false,
          "variable": "number"
        },
        "position": {
          "x": 400,
          "y": 40
        }
      },
      {
        "id": "option_mode",
        "type": "option.choice",
        "typeVersion": 1,
        "config": {
          "name": "mode",
          "description": "add (keep what is there) or replace (delete first)",
          "required": false,
          "variable": "mode",
          "choices": "add\nreplace"
        },
        "position": {
          "x": 660,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_serverbackup.clone",
        "typeVersion": 1,
        "config": {
          "source": "{option_source}",
          "number": "{option_number}",
          "mode": "{option_mode}",
          "variable": "res"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_source",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "option_number",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "option_mode",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
