{
  "name": "roulette",
  "description": "European roulette: a number (0-36) or red, black, even, odd, low, high",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "roulette",
          "description": "European roulette: a number (0-36) or red, black, even, odd, low, high"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_bet",
        "type": "option.number",
        "typeVersion": 1,
        "config": {
          "name": "bet",
          "description": "Your bet",
          "required": true,
          "variable": "bet"
        },
        "position": {
          "x": 140,
          "y": 40
        }
      },
      {
        "id": "option_field",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "field",
          "description": "Number 0-36 or red/black/even/odd/low/high",
          "required": true,
          "variable": "field"
        },
        "position": {
          "x": 400,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_casino.roulette",
        "typeVersion": 1,
        "config": {
          "bet": "{option_bet}",
          "field": "{option_field}",
          "variable": "res"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_bet",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "option_field",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
