{
  "name": "dice",
  "description": "Guess the die (1-6), 6x the bet",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "dice",
          "description": "Guess the die (1-6), 6x the bet"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_bet",
        "type": "option.number",
        "typeVersion": 1,
        "config": {
          "name": "bet",
          "description": "Your bet",
          "required": true,
          "variable": "bet"
        },
        "position": {
          "x": 140,
          "y": 40
        }
      },
      {
        "id": "option_number",
        "type": "option.choice",
        "typeVersion": 1,
        "config": {
          "name": "number",
          "description": "Your number",
          "required": true,
          "variable": "number",
          "choices": "1\n2\n3\n4\n5\n6"
        },
        "position": {
          "x": 400,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_casino.dice",
        "typeVersion": 1,
        "config": {
          "bet": "{option_bet}",
          "number": "{option_number}",
          "variable": "res"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_bet",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "option_number",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
