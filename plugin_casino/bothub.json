{
  "schemaVersion": 1,
  "id": "plugin_casino",
  "name": "Casino",
  "version": "1.1.0",
  "description": "Coinflip, dice, slots, roulette and blackjack with bets from the Economy module; the payout rate (RTP) is set per bot.",
  "developer": {
    "name": "BotHub"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "scheduler",
      "discord.interactions.reply",
      "modules.economy.balance.read",
      "modules.economy.balance.write"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/coinflip.json",
    "commands/dice.json",
    "commands/slots.json",
    "commands/roulette.json",
    "commands/blackjack.json"
  ],
  "nodes": [
    "coinflip",
    "dice",
    "slots",
    "roulette",
    "blackjack"
  ],
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  },
  "icon": "🎰",
  "category": "fun",
  "services": {
    "tasks": [
      {
        "name": "expire",
        "every": "1m"
      }
    ]
  },
  "dashboard": {
    "settings": "dashboard/settings.json"
  }
}
