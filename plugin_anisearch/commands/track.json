{
  "name": "anisearch-track",
  "description": "Announces new episodes of an anime",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "anisearch-track",
          "description": "Announces new episodes of an anime",
          "permissions": {
            "allowed_roles": [
              {
                "id": "everyone"
              }
            ],
            "banned_roles": [],
            "required_permissions": [
              "manage_guild"
            ],
            "banned_channels": [],
            "hide_without_permission": true
          }
        },
        "position": {
          "x": 120,
          "y": 240
        }
      },
      {
        "id": "option_title",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "title",
          "description": "Title",
          "required": true,
          "variable": "title"
        },
        "position": {
          "x": 120,
          "y": 110
        }
      },
      {
        "id": "track",
        "type": "plugin.plugin_anisearch.track",
        "typeVersion": 1,
        "config": {
          "title": "{option_title}",
          "variable": "tr"
        },
        "position": {
          "x": 440,
          "y": 240
        }
      },
      {
        "id": "ok",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "✅ Tracking **{tr}**: new episodes are posted in {tr.channel}."
          },
          "target": "reply"
        },
        "position": {
          "x": 760,
          "y": 240
        }
      },
      {
        "id": "already",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "ℹ️ **{tr}** is tracked already."
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 760,
          "y": 370
        }
      },
      {
        "id": "none",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ No anime found for \"{option_title}\"."
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 760,
          "y": 500
        }
      },
      {
        "id": "nochan",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ Set the announcement channel on the plugin page first."
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 1080,
          "y": 370
        }
      },
      {
        "id": "full",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ 50 anime are tracked already. Remove one with /anisearch-untrack."
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 1080,
          "y": 500
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 120,
          "y": 760
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 440,
          "y": 760
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_title",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "track",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "track",
          "port": "next"
        },
        "to": {
          "node": "ok",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "track",
          "port": "already"
        },
        "to": {
          "node": "already",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "track",
          "port": "not_found"
        },
        "to": {
          "node": "none",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "track",
          "port": "no_channel"
        },
        "to": {
          "node": "nochan",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "track",
          "port": "full"
        },
        "to": {
          "node": "full",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
