{
  "name": "anisearch-manga",
  "description": "Searches a manga on AniList",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "anisearch-manga",
          "description": "Searches a manga on AniList"
        },
        "position": {
          "x": 400,
          "y": 190
        }
      },
      {
        "id": "option_title",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "title",
          "description": "Title",
          "required": true,
          "variable": "title"
        },
        "position": {
          "x": 400,
          "y": 40
        }
      },
      {
        "id": "search",
        "type": "plugin.plugin_anisearch.search",
        "typeVersion": 1,
        "config": {
          "title": "{option_title}",
          "media_type": "manga",
          "variable": "ani"
        },
        "position": {
          "x": 400,
          "y": 340
        }
      },
      {
        "id": "found",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "embeds": [
              {
                "color": "#02a9ff",
                "title": "{ani}",
                "url": "{ani.url}",
                "thumbnail_url": "{ani.cover}",
                "description": "**English Name:** {ani.english}\n**Japanese Name:** {ani.japanese}\n\n**Rating:** {ani.rating}/10 ⭐\n**Status:** {ani.status}",
                "fields": [
                  {
                    "name": "Published",
                    "value": "**Start Date:** {ani.start}\n**End Date:** {ani.end}",
                    "inline": true
                  },
                  {
                    "name": "Format",
                    "value": "**Type:** {ani.type}\n**Chapters:** {ani.chapters}\n**Volumes:** {ani.volumes}",
                    "inline": true
                  },
                  {
                    "name": "Synopsis",
                    "value": "{ani.synopsis}",
                    "inline": false
                  },
                  {
                    "name": "More Information",
                    "value": "{ani.url}",
                    "inline": false
                  }
                ],
                "footer": {
                  "text": "Age Rating: {ani.age} · Genres: {ani.genres}"
                }
              }
            ]
          },
          "target": "reply"
        },
        "position": {
          "x": 140,
          "y": 490
        }
      },
      {
        "id": "none",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ No manga found for \"{option_title}\"."
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 660,
          "y": 490
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 1300,
          "y": 190
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 1300,
          "y": 340
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_title",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "search",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "search",
          "port": "found"
        },
        "to": {
          "node": "found",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "search",
          "port": "not_found"
        },
        "to": {
          "node": "none",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
