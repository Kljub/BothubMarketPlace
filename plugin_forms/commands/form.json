{
  "name": "form",
  "description": "Opens a form of this server",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "form",
          "description": "Opens a form of this server",
          "permissions": {
            "allowed_roles": [
              {
                "id": "everyone"
              }
            ],
            "banned_roles": [],
            "required_permissions": [],
            "banned_channels": [],
            "hide_without_permission": true
          }
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_name",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "name",
          "description": "Name of the form (Plugins → Forms)",
          "required": true,
          "variable": "name"
        },
        "position": {
          "x": -200,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_forms.open",
        "typeVersion": 1,
        "config": {
          "name": "{option_name}",
          "variable": "form"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_name",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
