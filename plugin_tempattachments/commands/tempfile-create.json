        "position": {
          "x": 1100,
          "y": 40
        }
      },
      {
        "id": "option_expiring_date",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "expiring_date",
          "description": "Available until, e.g. 2026-12-31 23:59 (UTC)",
