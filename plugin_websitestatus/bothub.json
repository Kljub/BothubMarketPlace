{
  "schemaVersion": 1,
  "id": "plugin_websitestatus",
  "name": "Website Status Check",
  "version": "1.2.0",
  "description": "Watches websites, cloud services, platforms and game servers (AWS, Google Cloud, Azure, Cloudflare, Discord, GitHub, PlayStation, Xbox, Minecraft, Steam …): a status board in a channel and alerts when something goes down.",
  "developer": {
    "name": "BotHub"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "scheduler",
      "discord.messages.send",
      "discord.messages.edit",
      "http.check",
      "discord.interactions.reply",
      "http.outbound",
      "secrets.use"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/sitecheck.json",
    "commands/sitestatus.json",
    "commands/sitereport.json"
  ],
  "services": {
    "tasks": [
      {
        "name": "tick",
        "every": "1m"
      }
    ],
    "hosts": [
      "health.aws.amazon.com",
      "status.cloud.google.com",
      "azure.status.microsoft",
      "www.cloudflarestatus.com",
      "status.digitalocean.com",
      "status.linode.com",
      "www.vercel-status.com",
      "discordstatus.com",
      "www.githubstatus.com",
      "status.npmjs.org",
      "slack-status.com",
      "www.redditstatus.com",
      "status.dropbox.com",
      "status.twitch.com",
      "status.openai.com",
      "status.claude.com",
      "status.epicgames.com",
      "status.playstation.com",
      "xnotify.xboxlive.com",
      "api.mcsrvstat.us",
      "api.steampowered.com"
    ],
    "secrets": [
      "STEAM_API_KEY"
    ]
  },
  "nodes": [
    "site_status",
    "check_now",
    "show_status",
    "report"
  ],
  "dashboard": {
    "settings": "dashboard/settings.json"
  },
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  },
  "icon": "📡",
  "category": "utility"
}
