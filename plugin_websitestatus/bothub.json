{
  "schemaVersion": 1,
  "id": "plugin_websitestatus",
  "name": "Website Status Check",
  "version": "1.1.0",
  "description": "Watches websites and keeps a status board (online, warning, offline, latency) in a channel. Websites can share one embed per group.",
  "developer": {
    "name": "BotHub"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "scheduler",
      "discord.messages.send",
      "discord.messages.edit",
      "http.check",
      "discord.interactions.reply"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/sitecheck.json"
  ],
  "services": {
    "tasks": [
      {
        "name": "tick",
        "every": "1m"
      }
    ]
  },
  "nodes": [
    "site_status",
    "check_now"
  ],
  "dashboard": {
    "settings": "dashboard/settings.json"
  },
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  },
  "icon": "📡",
  "category": "utility"
}
