{
  "name": "duty-on",
  "description": "Sets you on duty (green)",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "duty-on",
          "description": "Sets you on duty (green)",
          "permissions": {
            "allowed_roles": [
              {
                "id": "everyone"
              }
            ],
            "banned_roles": [],
            "required_permissions": [],
            "banned_channels": [],
            "hide_without_permission": true
          }
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_note",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "note",
          "description": "What you are doing (optional)",
          "required": false,
          "variable": "note"
        },
        "position": {
          "x": -200,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_staffactivity.set_status",
        "typeVersion": 1,
        "config": {
          "status": "on",
          "note": "{option_note}",
          "variable": "duty"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_note",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
