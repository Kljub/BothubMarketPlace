{
  "schemaVersion": 1,
  "id": "plugin_rps",
  "name": "Rock Paper Scissors",
  "version": "1.0.0",
  "description": "Rock, paper, scissors against the bot (/rps) or as a duel (/rps-duel), with optional bets from the Economy module.",
  "developer": {
    "name": "BotHub"
  },
  "license": "MIT",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "scheduler",
      "discord.interactions.reply",
      "discord.members.read",
      "modules.economy.balance.read",
      "modules.economy.balance.write"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/rps.json",
    "commands/rps-duel.json"
  ],
  "nodes": [
    "solo",
    "duel"
  ],
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  },
  "icon": "✂️",
  "category": "fun",
  "services": {
    "tasks": [
      {
        "name": "expire",
        "every": "1m"
      }
    ]
  },
  "dashboard": {
    "settings": "dashboard/settings.json"
  }
}
