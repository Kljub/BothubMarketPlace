{
  "schemaVersion": 1,
  "id": "plugin_stocks",
  "name": "Stock Market",
  "version": "1.1.0",
  "description": "A fictional stock market per server: prices move every interval, members buy and sell shares with Economy money; a live price board in a channel of your choice.",
  "developer": {
    "name": "BotHub"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "discord.interactions.reply",
      "modules.economy.balance.read",
      "modules.economy.balance.write",
      "discord.messages.send",
      "discord.messages.edit",
      "scheduler"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/stocks.json",
    "commands/stock-buy.json",
    "commands/stock-sell.json",
    "commands/portfolio.json"
  ],
  "services": {
    "tasks": [
      {
        "name": "board_update",
        "every": "5m"
      }
    ]
  },
  "nodes": [
    "stocks",
    "buy",
    "sell",
    "portfolio"
  ],
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  },
  "icon": "🏦",
  "category": "fun",
  "dashboard": {
    "settings": "dashboard/settings.json"
  }
}
