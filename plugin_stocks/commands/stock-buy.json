{
  "name": "stock-buy",
  "description": "Buys shares of a stock",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "stock-buy",
          "description": "Buys shares of a stock"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_symbol",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "symbol",
          "description": "Stock symbol (see /stocks)",
          "required": true,
          "variable": "symbol"
        },
        "position": {
          "x": 140,
          "y": 40
        }
      },
      {
        "id": "option_shares",
        "type": "option.number",
        "typeVersion": 1,
        "config": {
          "name": "shares",
          "description": "Number of shares",
          "required": true,
          "variable": "shares"
        },
        "position": {
          "x": 360,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_stocks.buy",
        "typeVersion": 1,
        "config": {
          "symbol": "{option_symbol}",
          "shares": "{option_shares}",
          "variable": "res"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_symbol",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "option_shares",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
