{
  "schemaVersion": 1,
  "id": "plugin_criminal",
  "name": "Criminal",
  "version": "1.1.0",
  "description": "/steal: rob another member's wallet; /rob-bank: a crew robs a member's bank. Chances, loot, fines and cooldowns per bot; balances from the Economy module.",
  "developer": {
    "name": "BotHub"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "discord.interactions.reply",
      "discord.members.read",
      "modules.economy.balance.read",
      "modules.economy.balance.write",
      "scheduler",
      "modules.economy.bank.write"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/steal.json",
    "commands/rob-bank.json"
  ],
  "nodes": [
    "steal",
    "heist"
  ],
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  },
  "icon": "🕵️",
  "category": "fun",
  "services": {
    "tasks": [
      {
        "name": "expire",
        "every": "1m"
      }
    ]
  },
  "dashboard": {
    "settings": "dashboard/settings.json"
  }
}
