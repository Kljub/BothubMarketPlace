{
  "name": "translate",
  "description": "Translate a text into another language (DeepL)",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "translate",
          "description": "Translate a text into another language (DeepL)"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "opt_text",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "text",
          "description": "The text to translate",
          "required": true,
          "variable": "text"
        },
        "position": {
          "x": 120,
          "y": 40
        }
      },
      {
        "id": "opt_to",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "to",
          "description": "Language, e.g. DE, French, ja (empty: the default)",
          "required": false,
          "variable": "to"
        },
        "position": {
          "x": 380,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_translation.translate",
        "typeVersion": 1,
        "config": {
          "text": "{option_text}",
          "to": "{option_to}",
          "variable": "tr"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "opt_text",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "opt_to",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
