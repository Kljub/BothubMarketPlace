{
  "name": "soundboard-play",
  "description": "Plays a sound in your voice channel",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "soundboard-play",
          "description": "Plays a sound in your voice channel"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_sound",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "sound",
          "description": "Name of the sound (/soundboard-list)",
          "required": true,
          "variable": "sound"
        },
        "position": {
          "x": 140,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_soundboard.play",
        "typeVersion": 1,
        "config": {
          "sound": "{option_sound}",
          "channel": "{user.voice.channel.id}",
          "variable": "sb"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_sound",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
