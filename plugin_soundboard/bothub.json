{
  "schemaVersion": 1,
  "id": "plugin_soundboard",
  "name": "Soundboard",
  "version": "1.1.0",
  "description": "Sound clips members play in their voice channel: a panel with a button per sound, /soundboard-play, uploads with /soundboard-add.",
  "developer": {
    "name": "BotHub"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "storage.files",
      "scheduler",
      "discord.voice.connect",
      "discord.voice.speak",
      "discord.interactions.reply",
      "discord.members.read",
      "discord.guilds.read"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/soundboard.json",
    "commands/soundboard-play.json",
    "commands/soundboard-list.json",
    "commands/soundboard-stop.json",
    "commands/soundboard-add.json",
    "commands/soundboard-remove.json"
  ],
  "nodes": [
    "play",
    "add",
    "remove",
    "list",
    "panel",
    "stop"
  ],
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  },
  "icon": "🔊",
  "category": "fun",
  "services": {
    "tasks": [
      {
        "name": "idle",
        "every": "1m"
      }
    ]
  },
  "dashboard": {
    "settings": "dashboard/settings.json"
  }
}
