{
  "name": "trivia",
  "description": "A quiz question; the first right answer wins",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "trivia",
          "description": "A quiz question; the first right answer wins"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_difficulty",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "difficulty",
          "description": "easy, medium or hard (empty: any)",
          "required": false,
          "variable": "difficulty"
        },
        "position": {
          "x": 140,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_minigames.trivia",
        "typeVersion": 1,
        "config": {
          "difficulty": "{option_difficulty}",
          "variable": "res"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_difficulty",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
