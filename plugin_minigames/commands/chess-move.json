{
  "name": "chess-move",
  "description": "Makes a chess move, e.g. e2e4, Nf3 or O-O",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "chess-move",
          "description": "Makes a chess move, e.g. e2e4, Nf3 or O-O"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_move",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "move",
          "description": "Your move: e2e4, e7e8q, Nf3, exd5, O-O",
          "required": true,
          "variable": "move"
        },
        "position": {
          "x": 140,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_minigames.chessmove",
        "typeVersion": 1,
        "config": {
          "move": "{option_move}",
          "variable": "res"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_move",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
