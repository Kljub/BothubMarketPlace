{
  "schemaVersion": 1,
  "id": "plugin_minigames",
  "name": "Minigames",
  "version": "1.2.0",
  "description": "Dice duels, 5 dice, higher or lower, scratch cards, double or steal, mastermind, hangman, match pairs (memory), lights out, 2048, Connect 4, chess, trivia, begging and fishing. Bets and rewards use the Economy module.",
  "developer": {
    "name": "BotHub"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "sdk": {
    "version": 1,
    "permissions": [
      "storage",
      "scheduler",
      "discord.interactions.reply",
      "discord.members.read",
      "modules.economy.balance.read",
      "modules.economy.balance.write",
      "http.outbound"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/dicebet.json",
    "commands/5dice.json",
    "commands/high-low.json",
    "commands/scratchcard.json",
    "commands/dos.json",
    "commands/mastermind.json",
    "commands/hangman.json",
    "commands/matchpairs.json",
    "commands/lightsout.json",
    "commands/beg.json",
    "commands/fish.json",
    "commands/2048.json",
    "commands/connect4.json",
    "commands/chess.json",
    "commands/chess-move.json",
    "commands/trivia.json"
  ],
  "nodes": [
    "dicebet",
    "fivedice",
    "highlow",
    "scratchcard",
    "dos",
    "mastermind",
    "hangman",
    "matchpairs",
    "lightsout",
    "beg",
    "fish",
    "game2048",
    "connect4",
    "chess",
    "chessmove",
    "trivia"
  ],
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  },
  "icon": "🎮",
  "category": "fun",
  "services": {
    "tasks": [
      {
        "name": "expire",
        "every": "1m"
      }
    ],
    "hosts": [
      "opentdb.com"
    ]
  },
  "dashboard": {
    "settings": "dashboard/settings.json"
  }
}
