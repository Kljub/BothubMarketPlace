{
  "name": "ask",
  "description": "Ask the AI",
  "graph": {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger.slash",
        "typeVersion": 1,
        "config": {
          "command_name": "ask",
          "description": "Ask the AI"
        },
        "position": {
          "x": 400,
          "y": 240
        }
      },
      {
        "id": "option_question",
        "type": "option.text",
        "typeVersion": 1,
        "config": {
          "name": "question",
          "description": "Your question",
          "required": true,
          "variable": "question"
        },
        "position": {
          "x": 140,
          "y": 40
        }
      },
      {
        "id": "option_web",
        "type": "option.choice",
        "typeVersion": 1,
        "config": {
          "name": "web",
          "description": "Search the web first?",
          "required": false,
          "variable": "web",
          "choices": "yes\nno"
        },
        "position": {
          "x": 400,
          "y": 40
        }
      },
      {
        "id": "step",
        "type": "plugin.plugin_aichat.ask",
        "typeVersion": 1,
        "config": {
          "question": "{option_question}",
          "web": "{option_web}",
          "variable": "res"
        },
        "position": {
          "x": 400,
          "y": 420
        }
      },
      {
        "id": "error",
        "type": "utility.error_handler",
        "typeVersion": 1,
        "config": {
          "variable": "error"
        },
        "position": {
          "x": 400,
          "y": 700
        }
      },
      {
        "id": "error_reply",
        "type": "action.send_message",
        "typeVersion": 1,
        "config": {
          "message": {
            "mode": "normal",
            "content": "❌ {error}"
          },
          "target": "reply",
          "ephemeral": true
        },
        "position": {
          "x": 720,
          "y": 700
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "option_question",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "option_web",
          "port": "option"
        },
        "to": {
          "node": "trigger",
          "port": "options"
        }
      },
      {
        "from": {
          "node": "trigger",
          "port": "next"
        },
        "to": {
          "node": "step",
          "port": "in"
        }
      },
      {
        "from": {
          "node": "error",
          "port": "next"
        },
        "to": {
          "node": "error_reply",
          "port": "in"
        }
      }
    ]
  }
}
