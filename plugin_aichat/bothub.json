{
  "schemaVersion": 1,
  "id": "plugin_aichat",
  "name": "AI Chat",
  "version": "1.1.0",
  "description": "Chat with an AI (OpenAI, Anthropic, Groq, NVIDIA, Ollama or any OpenAI-compatible server): /ask, an event that answers mentions, conversation memory, persona prompts, optional web search.",
  "developer": {
    "name": "BotHub"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "sdk": {
    "version": 1,
    "permissions": [
      "secrets.use",
      "storage",
      "discord.interactions.reply",
      "discord.messages.send"
    ]
  },
  "main": "index.js",
  "commands": [
    "commands/ask.json",
    "commands/ask-reset.json",
    "commands/mention.json"
  ],
  "nodes": [
    "ask",
    "reset"
  ],
  "lang": {
    "en": "lang/en.json",
    "de": "lang/de.json"
  },
  "icon": "🤖",
  "category": "utility",
  "services": {
    "secrets": [
      "AI_API_KEY",
      "AI_URL",
      "BRAVE_API_KEY"
    ],
    "hosts": [
      "api.openai.com",
      "api.anthropic.com",
      "api.groq.com",
      "integrate.api.nvidia.com",
      "api.search.brave.com",
      "api.duckduckgo.com"
    ]
  },
  "dashboard": {
    "settings": "dashboard/settings.json"
  }
}
